# =====================================================================
# ONNESHA BLOG PLATFORM - ENVIRONMENT VARIABLES
# =====================================================================

# 1. Primary AI Model Key (Gemini Recommended for Native Web Grounding)
# Gemini 1.5/2.0 Flash includes native Google Search grounding with a generous free tier.
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Alternative Model Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROK_API_KEY=your_xai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
KIMI_API_KEY=your_moonshot_api_key_here

# 3. Optional Dedicated Web Search API (for Claude / DeepSeek research)
# Tavily provides 1,000 free research queries/month designed for AI agents.
TAVILY_API_KEY=your_tavily_api_key_here

# 4. Cron Security Secret (Protect scheduled /api/cron/publish webhook)
CRON_SECRET=your_random_secure_cron_secret_here

# 5. Admin Portal Secret Key (Only admin with this secret can log into dashboard)
NEXT_PUBLIC_ADMIN_SECRET=onnesha@admin2026

# 6. Cloud Database (Neon Serverless Postgres)
# When set, articles are saved to Neon cloud database for 24/7 cloud persistence.
# If omitted, articles fall back to local file and in-memory cache.
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# 7. Site URL for canonical links and sitemap.xml
NEXT_PUBLIC_SITE_URL=http://localhost:3000
